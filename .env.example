# Host ports
APP_PORT=8080
FRONTEND_DEV_PORT=5173

# Crawlab runtime
TZ=Asia/Shanghai
CRAWLAB_NODE_NAME=DEEPTRANX Master
CRAWLAB_TASK_HANDLER_MAXRUNNERS=8

# BHOL collection pipeline
BHOL_MONGO_DB=bhol_pipeline
BHOL_EXPORT_DIR=/data/exports/bhol
BHOL_CRAWLAB_SYNC=1

# Replace both values before first startup.
CRAWLAB_GRPC_AUTHKEY=change-this-grpc-auth-key
CRAWLAB_FS_FILER_AUTHKEY=change-this-filer-auth-key

# Frontend development
VITE_API_BASE_URL=/api
VITE_API_PROXY_TARGET=http://crawlab:8080

# Production image
CRAWLAB_IMAGE=deeptranx/crawlab:0.1.0-crawlab0.6.3
